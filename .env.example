DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopify_monobank

# Monobank
MONO_TOKEN=
WEBHOOK_URL=https://your-render-domain.onrender.com/api/webhooks/monobank
REDIRECT_URL=https://your-store.myshopify.com/pages/thank-you

# Shopify
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Optional alias for older env setups. Prefer SHOPIFY_STORE_DOMAIN.
SHOPIFY_STORE_URL=https://your-store.myshopify.com/
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Nova Poshta
NOVA_POSHTA_API_KEY=

# Meta Conversions API, optional
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0

NODE_ENV=development
PORT=3000
